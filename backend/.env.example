# ═══════════════════════════════════════
# HAYAT Life OS — Environment Variables
# ═══════════════════════════════════════

NODE_ENV=development
PORT=3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hayat_db
DB_USER=hayat_user
DB_PASSWORD=hayat_secret

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets (CHANGE IN PRODUCTION!)
JWT_ACCESS_SECRET=your-super-secret-access-key-change-me
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-me

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Anthropic Claude API (optional - AI features)
ANTHROPIC_API_KEY=
