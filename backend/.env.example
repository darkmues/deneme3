# ═══════════════════════════════════════
# HAYAT Life OS — Environment Variables
# cp .env.example .env && düzenle
# ═══════════════════════════════════════

NODE_ENV=development
PORT=3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hayat_db
DB_USER=hayat_user
DB_PASSWORD=hayat_secret          # ⚠️ Production'da değiştir!

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets — Production'da mutlaka güçlü, random değerler kullan!
# openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Anthropic Claude API (opsiyonel — AI özelliklerini aktifleştirir)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-20250514
